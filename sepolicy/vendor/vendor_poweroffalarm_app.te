# com.qualcomm.qti.poweroffalarm (seapp_contexts).

type vendor_poweroffalarm_app, appdomain, domain, halclientdomain, vendor_hal_alarm_qti_client, vendor_hal_perf_client;
type vendor_poweroffalarm_app_userfaultfd;

allow vendor_poweroffalarm_app app_api_service:service_manager { find };
allow vendor_poweroffalarm_app appdomain_tmpfs:file { ioctl read write getattr map execute };
allow vendor_poweroffalarm_app audioserver_service:service_manager { find };
allow vendor_poweroffalarm_app mediaserver_service:service_manager { find };
allow vendor_poweroffalarm_app mnt_vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_poweroffalarm_app system_app_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow vendor_poweroffalarm_app system_app_data_file:file { ioctl create setattr lock append unlink rename open watch watch_reads };
allow vendor_poweroffalarm_app system_app_data_file:lnk_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_poweroffalarm_app vendor_alarm_boot_prop:file { read getattr map open };
allow vendor_poweroffalarm_app vendor_persist_alarm_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow vendor_poweroffalarm_app vendor_persist_alarm_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow vendor_poweroffalarm_app vendor_poweroffalarm_app_userfaultfd:anon_inode { ioctl read create };
allowxperm vendor_poweroffalarm_app appdomain_tmpfs:file ioctl { 0x7701-0x770b };
dontaudit su vendor_poweroffalarm_app_userfaultfd:anon_inode { ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads };
type_transition vendor_poweroffalarm_app tmpfs:file appdomain_tmpfs;
type_transition vendor_poweroffalarm_app vendor_poweroffalarm_app:anon_inode vendor_poweroffalarm_app_userfaultfd "[userfaultfd]";
