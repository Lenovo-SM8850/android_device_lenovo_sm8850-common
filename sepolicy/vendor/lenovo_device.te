# Access to /dev/lenovo_penraw (lenovo_device).

allow platform_app lenovo_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow priv_app lenovo_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow system_app lenovo_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow untrusted_app_all lenovo_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
