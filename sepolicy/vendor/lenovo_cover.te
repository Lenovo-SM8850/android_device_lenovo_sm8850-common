type lenovo_cover, domain;
type lenovo_cover_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(lenovo_cover)

# Vendor-facing AIDL framework sensor service, not the sensors HAL directly.
binder_use(lenovo_cover)
binder_call(lenovo_cover, system_server)
binder_call(system_server, lenovo_cover)
allow lenovo_cover fwk_sensor_service:service_manager find;

allow lenovo_cover uhid_device:chr_file { open write ioctl };
allowxperm lenovo_cover uhid_device:chr_file ioctl { 0x5501 0x5503 0x5564 0x556d };
