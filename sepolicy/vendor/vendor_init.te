allow vendor_init oemowninfo_block_device:blk_file { setattr relabelfrom };
allow vendor_init vendor_lenovotb_init_prop:property_service { set };
allow vendor_init vendor_lgsi_battery_prop:property_service { set };
allow vendor_init vendor_ssr_prop:property_service { set };

# Stock touch device setup probes these nodes before changing ownership.
allow vendor_init { thp_device input_agent_device }:chr_file getattr;
