<resources>
    <!-- Start with an empty hub and let the user choose from every widget category. -->
    <string-array name="config_communalWidgetAllowlist" translatable="false" />
    <bool name="config_communalWidgetPickerFilterByCategory">false</bool>

    <!-- SDE completed-frame rate, formatted as fps: N.N by the driver. -->
    <string name="config_fpsInfoSysNode" translatable="false">/sys/class/drm/card0-sde-crtc-0/measured_fps</string>

    <!-- Thermal zone thermal_zone0 is cpullc-0-0 and reports millidegrees Celsius. -->
    <integer name="config_cpuTempDivider" translatable="false">1000</integer>

    <!-- Up to four apps in split screen; the shell still requires a large screen. -->
    <bool name="config_enableMultiAppSplit">true</bool>
</resources>
