# Audio
ro.config.vc_call_vol_steps=15

# Charger
persist.sys.ax_chg_bypass=true
persist.sys.battery_bypass_supported=true
ro.charger.enable_suspend=1

# Media
media.settings.xml=/vendor/etc/media_profiles_canoe_sku3.xml
media.stagefright.thumbnail.prefer_hw_codecs=true
vendor.mm.enable.qcom_parser=16563967

# SurfaceFlinger
ro.surface_flinger.display_update_imminent_timeout_ms=1000
ro.surface_flinger.set_idle_timer_ms?=500

# Wi-Fi Display
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0
